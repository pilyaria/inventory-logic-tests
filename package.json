{
  "name": "inventory-logic-tests",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.29.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/reporter": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "test:sorting": "wdio run ./wdio.conf.js --spec ./test/specs/inventory-sorting.spec.js",
    "test:cart": "wdio run ./wdio.conf.js --spec ./test/specs/cart-state.spec.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  }
}
